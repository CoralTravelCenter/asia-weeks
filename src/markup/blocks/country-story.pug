mixin countryStory(data, countryId)
    section.coral.country-story(class=`country-story--${countryId}`)
        .country-story__decor.country-story__decor--flower(
            aria-hidden="true"
            data-parallax="flower"
        )

        .country-story__inner.container
            article.country-story__card
                .country-story__content
                    h2= data.lead

                    p.country-story__text
                        strong= data.strongText
                        br
                        span= data.text

                img.country-story__decor(
                    src=data.decor
                    alt=""
                )