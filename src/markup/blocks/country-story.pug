mixin countryStory(data, countryId)
    .country-story-shell(data-gsap-section="country-story-flower")
        .country-story__decor.country-story__decor--flower(
            aria-hidden="true"
            data-gsap-decor="parallax"
            data-gsap-distance-desktop="5"
            data-gsap-distance-mobile="2"
        )

        section.coral.country-story(class=`country-story--${countryId}` data-gsap-section="country-story")
            .country-story__decor.country-story__decor--girl(
                aria-hidden="true"
            )

            .country-story__inner.container.layout-container-limit.center
                article.country-story__card
                    if data.decor
                        img.country-story__decor.country-story__decor--country(
                            src=data.decor
                            alt=""
                            aria-hidden="true"
                        )

                    .country-story__content
                        h2= data.lead

                        p.country-story__text
                            strong= data.strongText
                            br
                            span= data.text
