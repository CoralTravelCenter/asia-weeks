mixin countryCuisine(data)
  - const recommendationLink = typeof data.recommendation.link === "string" ? data.recommendation.link.trim() : ""
  - const hasRecommendationLink = recommendationLink && recommendationLink !== "#"
    section.coral.country-cuisine
        .coral__inner.container.layout-container-limit.center
            h2= data.title

            if data.text
                p.country-cuisine__text= data.text

            coral-pictorial(
                trait="vivid"
                layout="alt"
            )
                if data.phone_image
                    coral-image(
                        slot="visual-phone"
                        src=data.phone_image
                    )

                if data.desktop_image
                    coral-image(
                        slot="visual-wide"
                        src=data.desktop_image
                    )

                h3(slot="heading")= data.recommendation.title

                if data.recommendation.items.length
                    ul(slot="body", class="cuisine-list")
                      each item in data.recommendation.items
                          li= item

                if hasRecommendationLink
                    coral-button-group(
                        slot="actions"
                        trait="inline"
                        primary-trait="vivid"
                    )
                        coral-button(primary="")
                            a(href=recommendationLink)= data.recommendation.button

            if data.afterText
                p.country-cuisine__text.country-cuisine__text--after= data.afterText
