mixin countryWeather(data, countryTitle)
    - const seasonImages = ["/winter.jpg", "/spring.jpg", "/summer.jpg", "/fall.jpg"]
    section.coral.country-weather
        .coral__inner.container.layout-container-limit.center
            h2= data.title

            p.country-weather__text #[strong #{countryTitle}] — #{data.text}

            ul.country-weather__seasons
                each season, index in data.seasons
                    li.country-weather__season
                        article.weather-card
                            if seasonImages[index]
                                img.weather-card__image(
                                    src=seasonImages[index],
                                    alt="",
                                    loading="lazy",
                                )

                            h3.weather-card__title= season.title
                            p.weather-card__temperature= season.temperature
