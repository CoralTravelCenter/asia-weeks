mixin countryPlaces(data)
    section.coral.country-places
        .coral__inner.container
            h2= data.title

            .country-places__slider(data-places-slider)
                .country-places__viewport
                    .country-places__container
                        each place in data.items
                            .country-places__slide
                                coral-pictorial(
                                    trait="plain"
                                    layout="normal"
                                    style="display: block; width: 100%; height: 100%;"
                                )
                                    coral-image(
                                        slot="visual-wide"
                                        src=place.image
                                    )

                                    p(slot="body")!= place.text

                                    coral-button-group(
                                        slot="actions"
                                        trait="inline"
                                        primary-trait="vivid"
                                    )
                                        coral-button(primary="")
                                            a(href=data.link || "#")= data.button

                .country-places__dots