mixin countryVisa(data, countryId)
    section.coral.country-visa(data-gsap-section="country-visa")
        if data.decor
            img.country-visa__decor(
                src=data.decor
                alt=""
                aria-hidden="true"
                data-gsap-decor=countryId === "thailand" ? false : "parallax"
                data-gsap-side=countryId === "thailand" ? false : "right"
                data-gsap-distance-desktop=countryId === "thailand" ? false : "6"
                data-gsap-distance-mobile=countryId === "thailand" ? false : "3"
            )

        .coral__inner.container.layout-container-limit.center
            article.country-visa__card
                .country-visa__content
                    h2= data.title
                    p= data.text
