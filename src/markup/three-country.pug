include blocks/country-story
include blocks/country-weather
include blocks/country-visa
include blocks/country-cuisine
include blocks/country-resorts
include blocks/country-places
include blocks/country-massage
include blocks/country-hotels

section.coral.three-country
    .coral__inner.container
        h2 Три разных отдыха
        p #[strong Убедитесь сами: Азия бывает разной. Вьетнам, Китай и Таиланд] — три направления со своим характером. Сравните их по погоде, кухне, отелям, пляжам и главным местам, чтобы выбрать путешествие, которое подойдёт именно вам.

        nav.destinations-tabs(aria-label="Выбор страны")
            ul.destinations-tabs__list
                each country, index in destinations.countries
                    li.destinations-tabs__item
                        button.destinations-tabs__button(
                            type="button",
                            data-country-tab=country.id,
                            class=index === 0 ? "is-active" : "",
                            aria-selected=index === 0 ? "true" : "false",
                        )= country.tab

        .partners
            h2= destinations.partners.title
            p Наши партнеры, получите промокоды и тд...

            ul.partners__list
                each partner in destinations.partners.items
                    li.partners__item
                        article.partner-card
                            img.partner-card__image(
                                src=partner.image,
                                alt="",
                            )

                            .partner-card__content
                                h3.partner-card__title= partner.title

                                if partner.text
                                    p.partner-card__text= partner.text

                                coral-button(
                                    trait="pale",
                                    shape="pill",
                                    size="medium",
                                )
                                    a(
                                        href=partner.link || "#",
                                        data-partner=partner.id,
                                    )= partner.button

.destinations-tabs__content
    each country, index in destinations.countries
        .destinations-tabs__panel(
            data-country-panel=country.id,
            class=index === 0 ? "is-active" : "",
        )
            +countryStory(country.countryStory, country.id)
            +countryWeather(country.weather, country.title)
            +countryVisa(country.visa)
            +countryCuisine(country.cuisine)
            +countryResorts(country.resorts, country.id)
            +countryPlaces(country.places)
            +countryMassage(country.massage)
            +countryHotels(country.hotels, country.id)